{
  "name": "ai-tavern",
  "version": "0.1.13",
  "private": true,
  "description": "本地运行、由 AI API 驱动的网页酒馆程序",
  "author": "AI 酒馆项目",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --webpack --hostname 127.0.0.1 --port 3210",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build --webpack",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --hostname 127.0.0.1 --port 3210",
    "test": "npm run build && node --disable-warning=ExperimentalWarning --test tests/*.test.mjs",
    "test:storage": "node --disable-warning=ExperimentalWarning --test tests/storage.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "desktop:build:mac": "node scripts/构建macOS桌面包.mjs",
    "desktop:verify:mac": "node scripts/验证macOS桌面包.mjs",
    "db:generate": "drizzle-kit generate",
    "bundle:build": "node scripts/构建剧本包.mjs",
    "bundle:check": "node scripts/构建剧本包.mjs --check",
    "public:check": "node scripts/检查公开仓库.mjs",
    "public:check:history": "node scripts/检查公开仓库.mjs --history"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@electron/packager": "20.0.4",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "electron": "43.2.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
