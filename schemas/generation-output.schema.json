{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-tavern.local/schemas/generation-output.schema.json",
  "title": "AI 酒馆单回合生成输出",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "turn", "decision", "stateCommit", "warnings"],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "turn": {
      "$ref": "#/$defs/turn"
    },
    "decision": {
      "$ref": "#/$defs/decision"
    },
    "stateCommit": {
      "$ref": "#/$defs/stateCommit"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attributeChecks": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/attributeCheck"
      }
    },
    "sourceProgress": {
      "type": "integer",
      "minimum": 1,
      "description": "可选：本轮剧情实际推进到的原文章节号（1 起，可跨章节推进）。本轮剧情未明显推进到新章节时省略该字段；不能只为解锁后续原文章节而虚报进度。系统只会向前解锁，不会回退。"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene", "events", "dialogue"],
      "properties": {
        "scene": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "dialogue": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dialogue"
          }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "summary", "characterIds"],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "type": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "summary": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "characterIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "locationId": {
          "type": ["string", "null"]
        }
      }
    },
    "dialogue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "speakerId", "content"],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "speakerId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "content": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "addressedCharacterIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "prompt", "choices"],
      "properties": {
        "context": {
          "enum": ["proposal_response", "action_direction"]
        },
        "prompt": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "choices": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/choice"
          }
        }
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "description", "stance"],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "label": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "stance": {
          "enum": [
            "accept",
            "partial_accept",
            "reject",
            "benevolent",
            "neutral",
            "malicious"
          ]
        }
      }
    },
    "stateCommit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sceneTransition",
        "characterStateChanges",
        "relationshipChanges",
        "characterCardChanges",
        "worldBookChanges",
        "storyDirectionEvaluation",
        "summaryPatch"
      ],
      "properties": {
        "sceneTransition": {
          "$ref": "#/$defs/sceneTransition"
        },
        "characterStateChanges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/characterStateChange"
          }
        },
        "relationshipChanges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationshipChange"
          }
        },
        "characterCardChanges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/characterCardChange"
          }
        },
    "worldBookChanges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/worldBookChange"
      }
    },
    "plotThreadUpdates": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/plotThreadUpdate"
      }
    },
    "plotTriggerUpdates": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/plotTriggerUpdate"
      }
    },
    "appointments": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/appointmentList"
        }
      ],
      "description": "可选：剧情中角色约定的未来时间点（会面、交易、交付、赴考等剧情内事件，区别于剧本包预埋任务的 deadlineDay）。完整数组替换语义：null 清除全部约定，省略表示约定保持不变，数组为完整替换。"
    },
    "storyDirectionEvaluation": {
          "oneOf": [
            {
              "$ref": "#/$defs/storyDirectionEvaluation"
            },
            {
              "type": "null"
            }
          ]
        },
        "summaryPatch": {
          "type": "string"
        }
      }
    },
    "sceneTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locationId",
        "presentCharacterIds",
        "reason",
        "evidence"
      ],
      "properties": {
        "locationId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "locationName": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "进入新地点时必填；已有地点可省略，以本地资料为准。"
        },
        "locationDescription": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "进入新地点时必填；已有地点可省略，以本地资料为准。"
        },
        "presentCharacterIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "offstageUpdates": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/offstageUpdate"
          }
        },
        "timeAdvance": {
          "enum": ["moment", "hours", "one_day", "several_days"]
        },
        "gameTimeDayNext": {
          "type": "integer",
          "minimum": 1,
          "description": "本回合结束时的游戏内日期（整数，不得小于当前 gameTimeDay，不得回退；当前日在系统上下文中给出）。跨日剧情（正文出现次日/数日后等时间流逝）必须显式声明；与 timeAdvance 同时提供时以此字段为准，日期不回退、不重叠推进。未跨日时省略。"
        }
      }
    },
    "offstageUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["characterId", "locationId"],
      "properties": {
        "characterId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "locationId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "locationName": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "locationDescription": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "characterStateChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["characterId", "patch", "duration", "reason", "evidence"],
      "properties": {
        "characterId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "patch": {
          "type": "object",
          "minProperties": 1
        },
        "duration": {
          "enum": ["instant", "scene", "until_changed", "permanent"]
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "relationshipChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceCharacterId",
        "targetCharacterId",
        "dimension",
        "delta",
        "reason",
        "evidence"
      ],
      "properties": {
        "sourceCharacterId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "targetCharacterId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "dimension": {
          "enum": ["trust", "affection", "fear", "hostility", "respect"]
        },
        "delta": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "characterCardChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "characterId",
        "operation",
        "path",
        "reason",
        "evidence",
        "sourceTurnId"
      ],
      "properties": {
        "characterId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "operation": {
          "enum": ["add", "update", "deactivate"]
        },
        "path": {
          "enum": [
            "identity.titles",
            "identity.affiliations",
            "goals.longTerm",
            "beliefs",
            "fears",
            "vows",
            "permanentConditions",
            "abilities",
            "revealedSecrets",
            "relationshipMilestones"
          ]
        },
        "value": {},
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "sourceTurnId": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "worldBookEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keys", "content", "enabled"],
      "properties": {
        "keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "content": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "enabled": {
          "type": "boolean"
        },
        "constant": {
          "type": "boolean"
        },
        "position": {
          "enum": ["before_char", "after_char"]
        },
        "order": {
          "type": "number"
        },
        "extensions": {
          "type": "object"
        }
      }
    },
    "worldBookChangeBase": {
      "type": "object",
      "required": ["sourceTurnId", "reason", "evidence"],
      "properties": {
        "sourceTurnId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sourceStoryDirectionId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "worldBookChange": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "entry", "sourceTurnId", "reason", "evidence"],
          "properties": {
            "operation": {
              "const": "create"
            },
            "entry": {
              "$ref": "#/$defs/worldBookEntry"
            },
            "sourceTurnId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "sourceStoryDirectionId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "reason": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "evidence": {
              "$ref": "#/$defs/evidence"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "targetEntryId",
            "patch",
            "sourceTurnId",
            "reason",
            "evidence"
          ],
          "properties": {
            "operation": {
              "const": "update"
            },
            "targetEntryId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "patch": {
              "type": "object",
              "minProperties": 1
            },
            "sourceTurnId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "sourceStoryDirectionId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "reason": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "evidence": {
              "$ref": "#/$defs/evidence"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "targetEntryId",
            "sourceTurnId",
            "reason",
            "evidence"
          ],
          "properties": {
            "operation": {
              "const": "deactivate"
            },
            "targetEntryId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "sourceTurnId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "sourceStoryDirectionId": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "reason": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "evidence": {
              "$ref": "#/$defs/evidence"
            }
          }
        }
      ]
    },
    "attributeCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "characterId", "attribute", "difficulty", "context"],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "characterId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "attribute": {
          "enum": ["力量", "敏捷", "感知", "意志", "魅力", "智力", "体质"]
        },
        "difficulty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "context": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "appointmentList": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/appointment"
      }
    },
    "appointment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "atDay"],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "characterIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "atDay": {
          "type": "integer",
          "minimum": 1,
          "description": "游戏内约定日期（第 N 天，正整数 ≥1；五回合一天模式下同样按天计算，一天 = 5 个回合）。"
        }
      }
    },
    "plotThreadUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threadId", "operation", "reason", "evidence"],
      "properties": {
        "threadId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "operation": {
          "enum": ["seed", "payoff"]
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "plotTriggerUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["triggerId", "operation", "reason", "evidence"],
      "properties": {
        "triggerId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "operation": {
          "const": "fire"
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "storyDirectionEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "evidence",
        "continuity",
        "continuityReason",
        "recommendedModuleId",
        "suggestedNextDirection"
      ],
      "properties": {
        "status": {
          "enum": ["active", "completed"]
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          }
        },
        "continuity": {
          "enum": ["aligned", "diverged", "uncertain"]
        },
        "continuityReason": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "recommendedModuleId": {
          "oneOf": [
            { "$ref": "#/$defs/nonEmptyString" },
            { "type": "null" }
          ]
        },
        "suggestedNextDirection": {
          "oneOf": [
            { "$ref": "#/$defs/nextStoryDirection" },
            { "type": "null" }
          ]
        },
        "divergenceState": {
          "oneOf": [
            { "$ref": "#/$defs/divergenceState" },
            { "type": "null" }
          ],
          "description": "仅当 continuity=diverged 时填写；aligned/uncertain 时省略或置 null。"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["divergenceState"],
            "properties": {
              "divergenceState": {
                "type": "object"
              }
            }
          },
          "then": {
            "properties": {
              "continuity": {
                "const": "diverged"
              }
            }
          }
        }
      ]
    },
    "divergenceState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outlineRecoverable", "badEndDrift", "reason"],
      "properties": {
        "outlineRecoverable": {
          "enum": ["recoverable", "broken"],
          "description": "原作后续剧情的触发条件是否仍可满足：recoverable=仍可沿原作路径继续；broken=已不可满足，需另起炉灶。"
        },
        "badEndDrift": {
          "enum": ["rising", "neutral"],
          "description": "局势是否正滑向坏结局：rising=正在走向不可挽回；neutral=尚未向坏结局倾斜。"
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString",
          "maxLength": 500,
          "description": "判断依据（不超过 500 字）。"
        }
      }
    },
    "nextStoryDirection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "content", "reason"],
      "properties": {
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "content": { "$ref": "#/$defs/nonEmptyString" },
        "reason": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
