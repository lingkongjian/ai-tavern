{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ai-tavern.invalid/schemas/complete-runtime-archive-v1.json",
  "title": "AI 酒馆完整运行存档 v1.7",
  "description": "由 AI 酒馆自动导出的单剧本完整运行记录。该文件包含校验值，不建议手工编写或修改。",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec", "schemaVersion", "archiveId", "exportedAt", "summary", "data", "integrity"],
  "properties": {
    "spec": { "const": "ai_tavern_runtime_archive_v1" },
    "schemaVersion": { "enum": ["1.0.0", "1.1.0", "1.2.0", "1.3.0", "1.4.0", "1.5.0", "1.6.0", "1.7.0"] },
    "archiveId": { "type": "string", "minLength": 1 },
    "exportedAt": { "type": "string", "format": "date-time" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campaignName", "sessionName", "branchCount", "turnCount", "characterCount", "locationCount", "sourceDocumentCount", "manualSaveCount", "regenerationCount"],
      "properties": {
        "campaignName": { "type": "string" },
        "sessionName": { "type": "string" },
        "branchCount": { "type": "integer", "minimum": 1 },
        "turnCount": { "type": "integer", "minimum": 1 },
        "characterCount": { "type": "integer", "minimum": 0 },
        "locationCount": { "type": "integer", "minimum": 0 },
        "sourceDocumentCount": { "type": "integer", "minimum": 0 },
        "manualSaveCount": { "type": "integer", "minimum": 0 },
        "regenerationCount": { "type": "integer", "minimum": 0 }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campaigns", "sessions", "source_documents", "source_chunks", "branches", "turns", "messages", "events", "state_changes", "character_management_changes", "location_management_changes", "turn_regenerations", "materialized_states", "snapshots", "save_points"],
      "properties": {
        "campaigns": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/row" } },
        "sessions": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/row" } },
        "source_documents": { "$ref": "#/$defs/table" },
        "source_chunks": { "$ref": "#/$defs/table" },
        "branches": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/row" } },
        "turns": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/row" } },
        "turn_context_snapshots": { "$ref": "#/$defs/table" },
        "messages": { "$ref": "#/$defs/table" },
        "events": { "$ref": "#/$defs/table" },
        "state_changes": { "$ref": "#/$defs/table" },
        "character_management_changes": { "$ref": "#/$defs/table" },
        "location_management_changes": { "$ref": "#/$defs/table" },
        "story_module_management_changes": { "$ref": "#/$defs/table" },
        "world_book_management_changes": { "$ref": "#/$defs/table" },
        "content_asset_management_changes": { "$ref": "#/$defs/table" },
        "state_control_changes": { "$ref": "#/$defs/table" },
        "state_field_lock_changes": { "$ref": "#/$defs/table" },
        "state_lock_blocks": { "$ref": "#/$defs/table" },
        "turn_regenerations": { "$ref": "#/$defs/table" },
        "materialized_states": { "$ref": "#/$defs/table" },
        "snapshots": { "$ref": "#/$defs/table" },
        "save_points": { "$ref": "#/$defs/table" },
        "memory_settings": { "$ref": "#/$defs/table" },
        "memory_entries": { "$ref": "#/$defs/table" },
        "memory_chapters": { "$ref": "#/$defs/table" },
        "memory_retrievals": { "$ref": "#/$defs/table" }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "checksum"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "checksum": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "schemaVersion": { "enum": ["1.1.0", "1.2.0", "1.3.0", "1.4.0", "1.5.0", "1.6.0", "1.7.0"] } },
        "required": ["schemaVersion"]
      },
      "then": {
        "properties": {
          "data": {
            "required": ["memory_settings", "memory_entries", "memory_chapters", "memory_retrievals"]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "schemaVersion": { "enum": ["1.2.0", "1.3.0", "1.4.0", "1.5.0", "1.6.0", "1.7.0"] } },
        "required": ["schemaVersion"]
      },
      "then": {
        "properties": {
          "data": {
            "required": ["story_module_management_changes"]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "schemaVersion": { "enum": ["1.3.0", "1.4.0", "1.5.0", "1.6.0", "1.7.0"] } },
        "required": ["schemaVersion"]
      },
      "then": {
        "properties": {
          "data": {
            "required": ["state_control_changes", "state_field_lock_changes", "state_lock_blocks"]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "schemaVersion": { "enum": ["1.4.0", "1.5.0", "1.6.0", "1.7.0"] } },
        "required": ["schemaVersion"]
      },
      "then": {
        "properties": {
          "data": {
            "required": ["turn_context_snapshots"]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "schemaVersion": { "enum": ["1.5.0", "1.6.0", "1.7.0"] } },
        "required": ["schemaVersion"]
      },
      "then": {
        "properties": {
          "data": {
            "required": ["world_book_management_changes"]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "schemaVersion": { "enum": ["1.6.0", "1.7.0"] } },
        "required": ["schemaVersion"]
      },
      "then": {
        "properties": {
          "data": {
            "required": ["content_asset_management_changes"]
          }
        }
      }
    }
  ],
  "$defs": {
    "row": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "null"] }
    },
    "table": {
      "type": "array",
      "items": { "$ref": "#/$defs/row" }
    }
  }
}
