# 服务端专用。不要给密钥添加 NEXT_PUBLIC_ 前缀。
# 可选：deepseek、opencode_go、openai_compatible、local_openai_compatible。
AI_PROVIDER=deepseek
AI_API_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-v4-flash
# LM Studio 可改为 json_schema；不支持结构化输出的接口可改为 prompt_only。
AI_JSON_MODE=response_format
AI_TAVERN_DATA_DIR=./data
# 自动保留最近 12 份整库备份，可设置为 3–50。
AI_TAVERN_BACKUP_RETENTION=12
NEXT_TELEMETRY_DISABLED=1
